[gd_resource type="ShaderMaterial" load_steps=3 format=3 uid="uid://r3ixtr5gf6jk"]

[ext_resource type="Texture2D" uid="uid://c8gik2ws4kbpu" path="res://TheScaled/assets/Transitions/TransitionTex.png" id="1_yenyh"]

[sub_resource type="Shader" id="Shader_y8k17"]
code = "shader_type canvas_item;

uniform sampler2D transitionTex;
uniform float threshold : hint_range(0,1);

void fragment() {
    float falloff = 1.0 - texture(transitionTex, UV).r;
    
    // helps with falloff artifacts issues towards the transition extremes
    float remap  = mix(-0.1, 1.1, threshold);
    falloff = step(falloff, remap);
    COLOR.a = falloff;
}
"

[resource]
resource_local_to_scene = true
shader = SubResource("Shader_y8k17")
shader_parameter/transitionTex = ExtResource("1_yenyh")
shader_parameter/threshold = 0.6000000285
